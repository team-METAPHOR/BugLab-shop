# dev(재현) 서버 설정 예시. server/.env.dev로 복사한 뒤 값을 바꿔 사용한다.
# 아래 값은 예시일 뿐 실제 비밀값이 아니다.
APP_ENV=dev
PORT=3100
HOST=127.0.0.1
# DATA_DIR=./data
# STATIC_DIR=../dist
# SESSION_COOKIE_NAME=buglab_dev_sid
COOKIE_SECURE=false
# BUILD_COMMIT=

# 필수: 없으면 dev 서버가 시작되지 않는다.
TEST_CONTROL_TOKEN=change-me-dev-control-token
TEST_ACCOUNT_PASSWORD=change-me-qa-password
# 선택: 메타포 소유 확인용 공개 토큰 (SDK는 dev에서 계속 비활성).
# METAPHOR_VERIFY_TOKEN=
