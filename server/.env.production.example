# production(운영) 서버 설정 예시. server/.env.production으로 복사한 뒤 값을 바꿔 사용한다.
# 아래 값은 예시일 뿐 실제 비밀값이 아니다.
APP_ENV=production
PORT=3200
HOST=127.0.0.1
# DATA_DIR=./data
# STATIC_DIR=../dist
# SESSION_COOKIE_NAME=buglab_sid
# 운영은 HTTPS 배포를 전제로 true(Secure 쿠키).
# http://localhost 등 HTTP로만 production을 미리 볼 때는 false로 바꿔야 로그인 쿠키가 저장된다.
COOKIE_SECURE=true
# BUILD_COMMIT=

# 선택: 둘 다 있으면 발표용 데모 계정을 시드한다.
# DEMO_ACCOUNT_EMAIL=demo@example.com
# DEMO_ACCOUNT_PASSWORD=change-me-demo-password

# 선택: 메타포 JavaScript SDK. 세 값이 모두 있으면 index.html에 SDK 스크립트를 넣고 CSP에 두 origin을 허용한다.
# production에서만 동작한다(dev는 무시). 프로젝트 키는 브라우저에 노출되는 공개 키다.
# SDK는 메타포 백엔드가 <METAPHOR_API_URL>/sdk/v1/metaphor.js(최신)로 서빙한다. 로컬 백엔드 기본 포트는 8000.
# 프로젝트 키(mpk_...)는 메타포 대시보드의 위젯 설정 화면에서 확인한다.
# METAPHOR_SDK_URL=http://localhost:8000/sdk/v1/metaphor.js
# METAPHOR_API_URL=http://localhost:8000
# METAPHOR_PROJECT_KEY=mpk_...

# 선택: 메타포 프로그램의 소유 확인 화면에서 받은 공개 토큰. dev/production 모두 지원.
# 있으면 GET /.well-known/metaphor-verify.txt가 앞뒤 공백을 뺀 토큰을 text/plain으로 반환하고,
# 없으면 404. UTF-8 기준 최대 1024바이트.
# METAPHOR_VERIFY_TOKEN=
